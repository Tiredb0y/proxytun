<Window x:Class="AppProxyManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="app.ico" Title="App Proxy Manager" Width="900" Height="700" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Routing status -->
    <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <Ellipse x:Name="RoutingDot" Width="14" Height="14" Fill="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <StackPanel>
          <TextBlock Text="App Proxy Manager" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock x:Name="TxtRouting" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Proxy settings -->
    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="10" Padding="16" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="Proxy settings" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/>
            <ColumnDefinition Width="90"/><ColumnDefinition Width="12"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Host / IP" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtHost"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Port" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtPort"/>
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="Type" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
              <RadioButton x:Name="RbSocks" Content="SOCKS5" GroupName="ptype" Margin="0,0,16,0"/>
              <RadioButton x:Name="RbHttp" Content="HTTP" GroupName="ptype"/>
            </StackPanel>
          </StackPanel>
        </Grid>
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Username (optional)" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtUser"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Password (optional)" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PwdBox"/>
          </StackPanel>
          <Button Grid.Column="4" x:Name="BtnTest" Content="Test connection" VerticalAlignment="Bottom" Click="BtnTest_Click"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Ellipse x:Name="ProxyDot" Width="10" Height="10" Fill="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock x:Name="TxtProxyStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Application list -->
    <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="16,12">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Applications routed through the proxy (everything else stays direct)" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ListBox Grid.Row="1" x:Name="AppList" SelectionMode="Extended">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="1" Margin="4,0,12,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding FileName}" Foreground="{StaticResource Muted}" Margin="8,0,0,0"/>
                  </StackPanel>
                  <TextBlock Text="{Binding Path}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                  <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}"/>
                </StackPanel>
                <Button Grid.Column="3" Content="Remove" Style="{StaticResource LinkButton}" Tag="{Binding Path}" Click="BtnRemoveOne_Click"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="1" x:Name="TxtEmpty" Text="No applications yet. Click “Add Application” or drop .exe files here."
                   Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
    </Border>

    <!-- Controls -->
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="BtnAdd" Content="Add Application" Click="BtnAdd_Click" Margin="0,0,8,0"/>
      <Button Grid.Column="1" x:Name="BtnRemove" Content="Remove Selected" Click="BtnRemove_Click"/>
      <Button Grid.Column="3" x:Name="BtnStart" Content="Start Routing" Style="{StaticResource PrimaryButton}" Click="BtnStart_Click" Margin="0,0,8,0"/>
      <Button Grid.Column="4" x:Name="BtnStop" Content="Stop Routing" Click="BtnStop_Click" Margin="0,0,8,0"/>
      <Button Grid.Column="5" x:Name="BtnSettings" Content="Settings" Click="BtnSettings_Click"/>
    </Grid>

    <TextBlock Grid.Row="4" x:Name="TxtStats" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,10,0,0"/>
  </Grid>
</Window>
